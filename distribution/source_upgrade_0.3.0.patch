+// Only audio outputs that are known virtual cables can become the game microphone.
+// Hardware speakers are deliberately excluded to prevent feedback.
+func nextCableOutput(devs []AudioDevice, prev int) int {
+	for offset := 1; offset <= len(devs); offset++ {
+		i := (prev + offset) % len(devs)
+		if i >= 0 && likelyCable(devs[i].Name) {
+			return i
+		}
+	}
+	return -1
+}
